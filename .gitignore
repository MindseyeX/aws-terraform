# Terraform working dirs and state - state can contain secrets, never commit it
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
plan.txt

# Generated per-sandbox by bootstrap (contains your account ID)
backend.hcl

# Override files are for local experiments
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the lock file - it pins provider versions for reproducible builds
!.terraform.lock.hcl

# Secrets - pass with -var-file, never commit
*.secret.tfvars
.env
*.pem
*.key

# Terraform CLI config (can contain API tokens)
.terraformrc
terraform.rc

# Editor / OS clutter
.vscode/
.idea/
*.swp
.DS_Store
